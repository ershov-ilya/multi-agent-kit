{
  "name": "multi-agent-kit",
  "version": "1.1.0",
  "description": "One source of skills, agents, rules and commands for Claude Code, Cursor and Codex, with public and private layers",
  "type": "module",
  "bin": {
    "multi-agent-kit": "bin/multi-agent-kit.mjs"
  },
  "exports": {
    ".": "./src/sync.mjs",
    "./create": "./src/create.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "template",
    "kit-template",
    "docs",
    "AGENTS.md",
    "multi-agent-kit.source.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "node bin/multi-agent-kit.mjs lint packs",
    "version:major": "node scripts/bump.mjs major",
    "version:minor": "node scripts/bump.mjs minor",
    "version:patch": "node scripts/bump.mjs patch"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills",
    "multi-agent",
    "scaffold"
  ],
  "author": "Ilya Ershov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ershov-ilya/multi-agent-kit.git"
  },
  "bugs": "https://github.com/ershov-ilya/multi-agent-kit/issues",
  "homepage": "https://github.com/ershov-ilya/multi-agent-kit#readme"
}
